# Dev-only: used by vite.config.ts for `npm run dev` API proxies (not bundled into the client).
# Copy to `.env` and set real values — do not commit `.env`.

# REST API base URL (origin is derived for workspace entity + search proxies) — required for map search.
REST_API_BASE_URL=https://your-api-host.example/api
#
# Two visitor modes (TdpGis.Api requires Entra JWT on GIS routes):
# - Public / not signed in: SPA calls GET /api/security/enable-gis-api → HTTP-only `gis_api_access_token` (client credentials; see GIS_CLIENT_CREDENTIALS_SCOPE below), or set a static bearer:
# REST_API_BEARER_TOKEN=
# PUBLIC_API_BEARER_TOKEN=   (alias — same purpose as REST_API_BEARER_TOKEN)
# - Signed in: user’s `auth_access_token` cookie is Bearer; private workspace merged server-side when configured.

# Optional: legacy `/api/gis/*` catch-all proxy (`api/gis/[...path].ts`). Not used by the React app workspace flow.
# GIS_API_BASE_URL=https://your-gis-host.example/api
# GIS_API_ACCESS_TOKEN=

# Workspace-scoped routes (same as Vercel serverless env)
# Public GIS workspace — always loaded (anonymous and signed-in users).
PUBLIC_WORKSPACE_ID=
PUBLIC_WORKSPACE_ACCESS_TOKEN=
# Optional: legacy names; used when PUBLIC_* are unset (single-workspace deploys).
WORKSPACE_ID=
WORKSPACE_ACCESS_TOKEN=
# Optional private workspace — merged server-side when the user is signed in (HTTP-only auth cookie).
PRIVATE_WORKSPACE_ID=
PRIVATE_WORKSPACE_ACCESS_TOKEN=
# Alternate names (also supported): WORKSPACE_ID_PUBLIC, WORKSPACE_ACCESS_TOKEN_PUBLIC,
# WORKSPACE_ID_PRIVATE, WORKSPACE_ACCESS_TOKEN_PRIVATE.
# Note: `npm run dev` proxies only the public workspace for GET /api/gis/workspace-entities. Use `vercel dev`
# (or deploy) to exercise merged public + private lists with real auth cookies.

# Optional: if true, redirect unsigned visitors to /api/auth/login on load. Leave off so public users can browse without signing in (server must still expose a bearer for anonymous API calls — see REST_API_BEARER_TOKEN above).
# VITE_AUTH_REDIRECT_ON_LOAD=true

# Public (bundled) — Mapbox token
VITE_MAPBOX_ACCESS_TOKEN=

# Microsoft Entra ID — server-only (Vercel / `vercel dev`). Register Web redirect URI = AUTH_REDIRECT_URI.
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AUTH_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback
# Optional: AUTH_POST_LOGIN_REDIRECT=/   (path on same origin, or full URL to same origin)
# AUTH_SCOPE must include TdpGis.Api delegated permission so the access_token is valid for the API (audience + app role).
# Example (replace with your API application ID URI / scope): openid profile email offline_access api://YOUR_API_APP_ID/TdpGisApi.Access
# AUTH_SCOPE=openid profile email offline_access
#
# Client credentials for GET /api/security/enable-gis-api (HTTP-only `gis_api_access_token` cookie for anonymous GIS).
# Prefer `GIS_CLIENT_CREDENTIALS_SCOPE`; otherwise `API_SCOPE` is used. Example: api://YOUR_API_APP_ID/.default
# GIS_CLIENT_CREDENTIALS_SCOPE=
# API_SCOPE=
