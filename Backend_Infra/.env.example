# Copy to .env in this folder and fill values.
#   copy .env.example .env
# Deploy-Demo-Infra.ps1 -Phase Secrets reads .env and writes these into Key Vault.
# .env is gitignored — do not commit it.

# Required
TDPGIS_DATABASE_CONNECTION_STRING=Host=...;Database=...;Username=...;Password=...;
TDPGIS_API_TENANT_ID=
TDPGIS_API_CLIENT_ID=
TDPGIS_ENDPOINTS_CLIENT_ID=
TDPGIS_ENDPOINTS_CLIENT_SECRET=

# Optional — defaults are used if omitted
# TDPGIS_API_AUDIENCE=api://<api-client-id>
# TDPGIS_API_ACCESS_ROLE=TdpGisApi.Access
# TDPGIS_ENDPOINTS_TENANT_ID=
# TDPGIS_ENDPOINTS_CALLBACK=/signin-oidc
# TDPGIS_ENDPOINTS_ADMIN_ROLE=Gis.Admin
# TDPGIS_ENDPOINTS_VIEWER_ROLE=Gis.Viewer

# Required only when main.bicepparam registryUsername is set
# TDPGIS_REGISTRY_PASSWORD=
