@{
    ViewData["Title"] = "Access denied";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h4">Access denied</h1>
        <p class="text-muted">
            Your account is signed in but is not assigned a role for this application.
            Ask an administrator to assign you the <strong>GIS Viewer</strong> or <strong>GIS Admin</strong> app role in Microsoft Entra, then sign out and sign in again.
        </p>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Home</a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-secondary">Sign out</button>
            </form>
        </div>
    </div>
</div>